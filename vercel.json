{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/changelog",
      "destination": "/team.html"
    },
    {
      "source": "/comments",
      "destination": "/team.html"
    },
    {
      "source": "/review",
      "destination": "/review.html"
    }
  ]
}
